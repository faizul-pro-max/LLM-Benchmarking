# GPU Server (update when you rent a new instance)
GPU_SERVER_IP=203.0.113.45
VLLM_URL=http://${GPU_SERVER_IP}:8000
# vLLM API key (set if vLLM launched with --api-key); sent as Authorization: Bearer
VLLM_API_KEY=
GPU_AGENT_URL=http://${GPU_SERVER_IP}:9100
# GPU agent requires this as the x-api-key header on /gpu (leave blank if agent has no auth)
GPU_AGENT_API_KEY=

# Scenario Controller (control plane — list/switch scenarios, benchmark lock)
GPU_CONTROLLER_URL=http://${GPU_SERVER_IP}:9200
# Controller x-api-key — defaults to GPU_AGENT_API_KEY (one key secures all three servers)
GPU_CONTROLLER_API_KEY=

# Model to benchmark (HuggingFace model ID)
MODEL_NAME=google/gemma-3-4b-it

# Redis
REDIS_URL=redis://localhost:6379
# BullMQ worker queue (backend/consumers) — unused by the live benchmark run
# path, only needed if something enqueues jobs to it. launch.sh sets this
# automatically based on whether Docker/Redis is up; set explicitly to
# override (e.g. WORKER_ENABLED=false to always skip it).
WORKER_ENABLED=true

# SQLite
SQLITE_PATH=./data/bench.db

# Google Sheets (optional)
GOOGLE_SHEETS_ID=your_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY=./secrets/gcp-key.json

# API Server
PORT=3001
FRONTEND_URL=http://localhost:7755

# Benchmark defaults
DEFAULT_CONCURRENCY=10
DEFAULT_PROMPT_COUNT=100
WARMUP_REQUEST_COUNT=20

# HuggingFace workload datasets (optional overrides — safe, well-known
# defaults are baked in if these are left unset: tatsu-lab/alpaca for short,
# abisee/cnn_dailymail for long, daily_dialog for qa). Public datasets need no
# token; set HF_TOKEN only for gated datasets you have access to.
# HF_TOKEN=
# HF_DATASET_SHORT_REPO_ID=tatsu-lab/alpaca
# HF_DATASET_SHORT_CONFIG=default
# HF_DATASET_SHORT_SPLIT=train
# HF_DATASET_SHORT_FIELD=instruction
# HF_DATASET_LONG_REPO_ID=abisee/cnn_dailymail
# HF_DATASET_LONG_CONFIG=3.0.0
# HF_DATASET_LONG_SPLIT=train
# HF_DATASET_LONG_FIELD=article
# HF_DATASET_QA_REPO_ID=li2017dailydialog/daily_dialog
# HF_DATASET_QA_CONFIG=default
# HF_DATASET_QA_SPLIT=train
# HF_DATASET_QA_FIELD=dialog

# Per-run debug log (off by default) — writes logs/runs/<ts>_<name>_<runId>.log
# for each run, one line per event tagged req=<N> (matches the "Req #" shown
# in the UI), so a stuck request can be grepped directly out of that one file.
RUN_LOG_ENABLED=false
RUN_LOG_LEVEL=info
