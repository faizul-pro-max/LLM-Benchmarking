# GPU Server (update when you rent a new instance)
GPU_SERVER_IP=203.0.113.45
VLLM_URL=http://${GPU_SERVER_IP}:8000
# vLLM API key (set if vLLM launched with --api-key); sent as Authorization: Bearer
VLLM_API_KEY=
GPU_AGENT_URL=http://${GPU_SERVER_IP}:9100
# GPU agent requires this as the x-api-key header on /gpu (leave blank if agent has no auth)
GPU_AGENT_API_KEY=

# Model to benchmark (HuggingFace model ID)
MODEL_NAME=google/gemma-3-4b-it

# Redis
REDIS_URL=redis://localhost:6379

# SQLite
SQLITE_PATH=./data/bench.db

# Google Sheets (optional)
GOOGLE_SHEETS_ID=your_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_KEY=./secrets/gcp-key.json

# API Server
PORT=3001
FRONTEND_URL=http://localhost:7755

# Benchmark defaults
DEFAULT_CONCURRENCY=10
DEFAULT_PROMPT_COUNT=100
WARMUP_REQUEST_COUNT=20
